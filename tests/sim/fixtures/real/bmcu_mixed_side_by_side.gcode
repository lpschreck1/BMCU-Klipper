; change_filament_gcode = ;===== BMCU tool change ===========\n; Change Tool[previous_extruder] -> Tool[next_extruder] (layer [layer_num])\n; max_layer_z [max_layer_z]\n; max_print_height [max_print_height]\n; print_sequence [print_sequence]\n\n{\nlocal move_z = 1.5;\nlocal max_speed_toolchange = 350.0;\nlocal preheat_next_extruder = true;\nposition[2] = position[2] + 2.0;\nlocal speed_toolchange = max_speed_toolchange;\n\nif travel_speed < max_speed_toolchange then\n      speed_toolchange = travel_speed;\nendif\n\nif print_sequence == \"by object\" then\n\n    if max_layer_z < ((max_print_height - z_offset) - 2) then\n        move_z = z_offset + min(((max_layer_z - z_offset) + 2), max_print_height);\n    endif\n\nendif\n\n\"G91\nG1 Z\" + move_z + \" F600\nG90\n\";\n\"G1 F\" + (speed_toolchange * 60) + \"\n\";\n\nif previous_extruder < 2 then\n      \"MOVE_TO_XY_IDLE_POSITION_EXTRUDER\n\";\nendif\n\"M400\n\";\n\nif preheat_next_extruder and not((layer_num < 0) and (next_extruder == initial_tool)) then\n      \"\n\";\n      \"; nonblocking preheat for Tool\" + next_extruder + \"\n\";\n      if layer_num == 0 then\n            \"M104 S\" + first_layer_temperature[next_extruder] + \" T\" + next_extruder + \"\n\";\n      else\n            \"M104 S\" + temperature[next_extruder] + \" T\" + next_extruder + \"\n\";\n      endif\nendif\n\"BMCU_TOOL_CHANGE TOOL=\" + next_extruder + \"\n\";\nif filament_type[next_extruder] == \"PVA\" then\n\"SET_VELOCITY_LIMIT ACCEL=3000\n\";\nelse\nendif\nif previous_extruder != next_extruder and initial_extruder != next_extruder then\n\"BMCU_PRINT_PREEXTRUDE TOOL=\" + next_extruder + \"\n\";\nendif\n\"G90\n\";\n}\n
