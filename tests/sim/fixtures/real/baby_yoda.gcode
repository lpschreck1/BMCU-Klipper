; machine_start_gcode = SET_GCODE_VARIABLE MACRO=BMCU_REMAP_NOT_RUN VARIABLE=x VALUE=0\n;===== Snapmaker U1 start sequence =====================\n\n\nBMCU_PRINT_BEGIN SCHEMA=1 RESET=1\n{if is_extruder_used[0]}BMCU_PRINT_MAP TOOL=0{endif}\n{if is_extruder_used[1]}BMCU_PRINT_MAP TOOL=1{endif}\n{if is_extruder_used[2]}BMCU_PRINT_MAP TOOL=2{endif}\n{if is_extruder_used[3]}BMCU_PRINT_MAP TOOL=3{endif}\n{if is_extruder_used[4]}BMCU_PRINT_MAP TOOL=4 MATERIAL=\"{filament_type[4]}\" COLOR=\"{filament_colour[4]}\"{endif}\n{if is_extruder_used[5]}BMCU_PRINT_MAP TOOL=5 MATERIAL=\"{filament_type[5]}\" COLOR=\"{filament_colour[5]}\"{endif}\n{if is_extruder_used[6]}BMCU_PRINT_MAP TOOL=6 MATERIAL=\"{filament_type[6]}\" COLOR=\"{filament_colour[6]}\"{endif}\n{if is_extruder_used[7]}BMCU_PRINT_MAP TOOL=7 MATERIAL=\"{filament_type[7]}\" COLOR=\"{filament_colour[7]}\"{endif}\nBMCU_PRINT_COMMIT\n\nPRINT_START\n\n\nDEFECT_DETECTION_START\nSET_PRINT_STATS_INFO TOTAL_LAYER={total_layer_count}\nSET_PRINT_STATS_INFO CURRENT_LAYER=0\nTIMELAPSE_START\nM140 S{bed_temperature_initial_layer_single}\nM104 T{initial_extruder} S140\nM204 S10000\n\nG28 X Y\nDEFECT_DETECT_NOODLE_FIRST\n;===== Bed foreign-object detection ========\nT{initial_extruder}\nG90\nDEFECT_DETECTION_DETECT_BED\n;===== Toolhead pick/place check =================\nSM_PRINT_CHECK_SWITCH_EXTRUDER\n\n;===== Auto feed, flow calibration and pre-extrusion ======================\nSM_PRINT_EXTRUDER_PREHEAT EXTRUDER=1 TEMP=140\nBMCU_AUTO_FEED EXTRUDER=0 INITIAL_TOOL={initial_extruder} REQUIRE_PLAN=1\nSM_PRINT_FLOW_CALIBRATE EXTRUDER=0\nSM_PRINT_EXTRUDER_PREHEAT EXTRUDER=2 TEMP=140\nBMCU_AUTO_FEED EXTRUDER=1 INITIAL_TOOL={initial_extruder} REQUIRE_PLAN=1\nSM_PRINT_FLOW_CALIBRATE EXTRUDER=1\nSM_PRINT_EXTRUDER_PREHEAT EXTRUDER=3 TEMP=140\nBMCU_AUTO_FEED EXTRUDER=2 INITIAL_TOOL={initial_extruder} REQUIRE_PLAN=1\nSM_PRINT_FLOW_CALIBRATE EXTRUDER=2\nBMCU_AUTO_FEED EXTRUDER=3 INITIAL_TOOL={initial_extruder} REQUIRE_PLAN=1\nSM_PRINT_FLOW_CALIBRATE EXTRUDER=3\nM104 S0 T0 A0\nM104 S0 T1 A0\nM104 S0 T2 A0\nM104 S0 T3 A0\nM104 T{initial_extruder} S{nozzle_temperature[initial_extruder] - 90}\n\n;===== Coarse homing =================\nT{initial_extruder}\nM106 S255\nM106 P2 S0\nMOVE_TO_DISCARD_FILAMENT_POSITION\nM109 T{initial_extruder} S{nozzle_temperature[initial_extruder] - 90}\nROUGHLY_CLEAN_NOZZLE_WITH_DISCARD\nMOVE_TO_XY_IDLE_POSITION_EXTRUDER\nG28 Z I140 J140\n\n;===== Build plate detection =================\nDETECT_BED_PLATE\n\n;===== Deep nozzle cleaning =================\nG90\nG0 Z5 F10000\nMOVE_TO_DISCARD_FILAMENT_POSITION\nM109 S{nozzle_temperature[initial_extruder] - 50}\nROUGHLY_CLEAN_NOZZLE\nMOVE_TO_XY_IDLE_POSITION_EXTRUDER\nFINELY_CLEAN_NOZZLE_STAGE_1\nM104 S{nozzle_temperature[initial_extruder] - 90}\nG0 Z5 F10000\nMOVE_TO_DISCARD_FILAMENT_POSITION\nROUGHLY_CLEAN_NOZZLE\nMOVE_TO_XY_IDLE_POSITION_EXTRUDER\nFINELY_CLEAN_NOZZLE_STAGE_2\n\n;===== Precision homing =================\nM106 S255\nM109 S{nozzle_temperature[initial_extruder] - 90}\nM190 S{bed_temperature_initial_layer_single}\nM107 P2\nG90\nG0 Z5 F10000\nWAIT_CHAMBER_TEMP TIMEOUT=180\n{if curr_bed_type==\"High Temp Plate\"}\nG28 Z Z_OFFSET -0.07\n{elsif curr_bed_type==\"Graphic Effect Plate\"}\nG28 Z Z_OFFSET -0.07\n{else}\nG28 Z\n{endif}\n\n;===== Snapmaker U1 plate policy =================\n{if curr_bed_type==\"Smooth PEI Plate\"}\nBED_MESH_CALIBRATE PROBE_COUNT=11,11 Z_OFFSET=-0.07\n{elsif curr_bed_type==\"Graphic Effect Plate\"}\nBED_MESH_CALIBRATE PROBE_COUNT=11,11 Z_OFFSET=-0.07\n{else}\nBED_MESH_CALIBRATE PROBE_COUNT=11,11\n{endif}\n\n;===== Prime line =================\nG90\nG1 Z1.5\nG0 X85 Y1 Z2 F18000\nM109 S{nozzle_temperature_initial_layer[initial_extruder]}\nG1 Z0.2\nM83\nG1 X185 E15 F360\nG1 Z1.5\n\nG90\nM106 S0
